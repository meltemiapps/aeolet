// Aeolet build configuration. Edit these values before the first build.

// From Google Cloud: the part of your iOS client ID before ".apps.googleusercontent.com".
GOOGLE_CLIENT_PREFIX = 477031645831-5csr86vglrlhiics2e6fatlut9ond16o
GOOGLE_URL_SCHEME = com.googleusercontent.apps.$(GOOGLE_CLIENT_PREFIX)

// Xcode > Settings > Accounts shows your team. Leave empty and pick it in Signing & Capabilities if you prefer.
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = com.meltemiapps.aeolet

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Shown under Settings > About once set. Keep the $() so the slashes are not read as a comment.
PUBLISHER_URL = https:/$()/REPLACE_ME
SOURCE_CODE_URL = https:/$()/REPLACE_ME
